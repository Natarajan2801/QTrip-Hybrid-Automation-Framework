# ============================================
# QTrip Automation Framework - Git Ignore
# ============================================

# Maven
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# IDE - IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# IDE - Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# IDE - NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# IDE - VS Code
.vscode/

# Build
build/
!**/src/main/**/build/
!**/src/test/**/build/

# Test Output
test-output/
screenshots/
logs/
*.log

# Reports (keep structure, ignore generated)
reports/*.html
reports/*.json
!reports/.gitkeep

# OS Generated
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db

# Environment files (may contain secrets)
.env
.env.local
*.env

# Selenium/WebDriver
geckodriver.log
chromedriver.log

# Temp files
*.tmp
*.temp
*.swp
*~

# Kotlin
.kotlin
